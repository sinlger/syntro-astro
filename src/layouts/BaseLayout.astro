---
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/global/Navigation.astro";
import Footer from "../components/global/Footer.astro";

interface Hreflang {
  locale: string;
  url: string;
}

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
}

interface Props {
  // Current locale code (e.g. "zh", "en"); "zh" maps to htmlLang "zh-Hans".
  lang: string;
  // Optional translation function for layout-level text (footer, nav, etc.).
  t?: (key: string, options?: any) => string;
  // Core SEO props forwarded to BaseHead.
  pageTitle: string;
  pageDescription: string;
  htmlLang: string;
  // Locale-agnostic path for this page (e.g. "/", "/CSV-to-vCard", "/blog/xxx").
  canonicalPath: string;
  // Optional explicit hreflang list. When omitted, alternates are generated for
  // every supported locale (correct for pages that exist in all languages).
  // Pages whose content only exists in one language (e.g. blog posts with
  // language-specific slugs) should pass their own list to avoid 404 alternates.
  hreflangs?: Hreflang[];
  // Optional Open Graph type ("website" default, "article" for blog posts).
  ogType?: string;
  // Optional absolute Open Graph image URL (falls back to the site default).
  ogImage?: string;
  // Optional article metadata; emitted as article:* Open Graph tags.
  article?: ArticleMeta;
}

const { lang, t, pageTitle, pageDescription, htmlLang, canonicalPath, hreflangs, ogType, ogImage, article } = Astro.props;

const siteUrl = "https://excel2vcf.com";
const supportedLocales = ["zh", "en", "ja", "ko", "fr", "de", "es"];
const defaultLocale = "zh";

// Build a fully-qualified URL with exactly one trailing slash so canonical,
// hreflang and sitemap all agree on the same normalized form.
const buildUrl = (loc: string, path: string) => {
  const joined = `${siteUrl}/${loc}${path}`.replace(/\/+$/, "");
  return `${joined}/`;
};

const canonicalUrl = buildUrl(lang, canonicalPath);

const hreflangsData =
  hreflangs ?? [
    ...supportedLocales.map((loc) => ({
      locale: loc === "zh" ? "zh-Hans" : loc,
      url: buildUrl(loc, canonicalPath),
    })),
    { locale: "x-default", url: buildUrl(defaultLocale, canonicalPath) },
  ];
---

<html
  lang={htmlLang}
  class="scroll-smooth selection:bg-accent-500 selection:text-white no-touchevents hydrated"
>
  <head>
    <BaseHead
      title={pageTitle}
      description={pageDescription}
      canonicalUrl={canonicalUrl}
      hreflangs={hreflangsData}
      siteUrl={siteUrl}
      ogType={ogType}
      ogImage={ogImage}
      ogLocale={htmlLang}
      article={article}
    />
  </head>
  <body class="bg-accent-25 flex flex-col min-h-svh">
    <Navigation lang={lang} t={t} />
    
    <main class="grow w-full"><slot /></main>
    <Footer lang={lang} t={t} />
  </body>
</html>
