---
// Language selector at the site root.
//
// Previously this route did an Accept-Language based 302, but Astro's i18n
// middleware (redirectToDefaultLocale) intercepted "/" before the page code ran,
// so every visitor ended up on /zh/. The middleware redirect is now disabled in
// astro.config.mjs and this page is a static, crawlable language chooser.
export const prerender = true;
import "../styles/global.css";

const siteUrl = "https://excel2vcf.com";
const canonicalUrl = `${siteUrl}/`;

const languages = [
  { code: "zh", hrefLang: "zh-Hans", path: "/zh/", native: "中文", label: "Chinese", note: "Excel/CSV 通讯录 ↔ vCard (VCF) 转换" },
  { code: "en", hrefLang: "en", path: "/en/", native: "English", label: "English", note: "Convert Excel/CSV contacts to vCard (VCF) and back" },
  { code: "ja", hrefLang: "ja", path: "/ja/", native: "日本語", label: "Japanese", note: "Excel/CSV の連絡先を vCard (VCF) に変換" },
  { code: "ko", hrefLang: "ko", path: "/ko/", native: "한국어", label: "Korean", note: "Excel/CSV 연락처를 vCard (VCF)로 변환" },
  { code: "fr", hrefLang: "fr", path: "/fr/", native: "Français", label: "French", note: "Convertir des contacts Excel/CSV en vCard (VCF)" },
  { code: "de", hrefLang: "de", path: "/de/", native: "Deutsch", label: "German", note: "Excel/CSV-Kontakte in vCard (VCF) umwandeln" },
  { code: "es", hrefLang: "es", path: "/es/", native: "Español", label: "Spanish", note: "Convertir contactos de Excel/CSV a vCard (VCF)" },
];

const pageTitle = "Excel2VCF – Excel/CSV to vCard (VCF) Converter";
const pageDescription =
  "Convert Excel/CSV contacts to vCard (VCF) and back, entirely in your browser. Choose your language to start. No uploads, no server, 100% private.";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />

    {languages.map((lang) => (
      <link rel="alternate" hreflang={lang.hrefLang} href={`${siteUrl}${lang.path}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Excel2VCF" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
    <meta name="theme-color" content="#3050FF" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body class="bg-accent-25 text-base-900 min-h-svh flex flex-col">
    <header class="w-full">
      <div class="max-w-5xl mx-auto px-6 py-6 flex items-center gap-3">
        <span class="inline-flex size-9 items-center justify-center rounded-lg bg-accent-600 text-white font-bold">E2V</span>
        <a href={canonicalUrl} class="font-bold text-lg">Excel2VCF</a>
      </div>
    </header>

    <main class="grow w-full">
      <section class="max-w-5xl mx-auto px-6 pt-8 pb-16">
        <div class="text-center">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
            Excel/CSV ⇄ vCard (VCF)
          </h1>
          <p class="mt-4 text-base-600 text-lg max-w-2xl mx-auto">
            Batch convert spreadsheets to vCard (VCF) for iOS/Android — or VCF back to Excel/CSV.
            Everything runs locally in your browser, so your contacts never leave your device.
          </p>
        </div>

        <h2 class="mt-12 mb-4 text-sm font-semibold uppercase tracking-wider text-base-500 text-center">
          Choose your language
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {languages.map((lang) => (
            <li>
              <a
                href={lang.path}
                hreflang={lang.hrefLang}
                lang={lang.code}
                class="flex flex-col h-full rounded-2xl ring-1 ring-base-200 bg-white px-6 py-5 hover:bg-accent-50 transition-colors"
              >
                <span class="text-xl font-bold text-accent-700">{lang.native}</span>
                <span class="text-sm text-base-500 mt-1">{lang.label}</span>
                <span class="text-sm text-base-600 mt-3">{lang.note}</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
          <a href="/en/Excel-to-vCard/" class="rounded-xl ring-1 ring-base-200 bg-white px-5 py-4 hover:bg-accent-50">
            <span class="font-semibold">Excel to vCard</span>
            <span class="block text-base-500 mt-1">XLSX / XLS → VCF</span>
          </a>
          <a href="/en/CSV-to-vCard/" class="rounded-xl ring-1 ring-base-200 bg-white px-5 py-4 hover:bg-accent-50">
            <span class="font-semibold">CSV to vCard</span>
            <span class="block text-base-500 mt-1">CSV → VCF</span>
          </a>
          <a href="/en/vCard-to-Excel/" class="rounded-xl ring-1 ring-base-200 bg-white px-5 py-4 hover:bg-accent-50">
            <span class="font-semibold">VCF to Excel</span>
            <span class="block text-base-500 mt-1">VCF → XLSX / CSV</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="w-full border-t border-base-200">
      <div class="max-w-5xl mx-auto px-6 py-8 text-sm text-base-500 flex flex-wrap gap-x-6 gap-y-2 justify-between">
        <span>© 2026 Excel2VCF</span>
        <span class="flex gap-4">
          <a href="/en/faq/" class="hover:text-accent-600">FAQ</a>
          <a href="/en/blog/" class="hover:text-accent-600">Blog</a>
          <a href="/en/privacy/" class="hover:text-accent-600">Privacy</a>
        </span>
      </div>
    </footer>
  </body>
</html>
