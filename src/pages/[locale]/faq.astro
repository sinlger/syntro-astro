---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import { initI18n } from "../../i18n.js";

export function getStaticPaths() {
  const locales = ["zh", "en", "ja", "ko", "fr", "de", "es"];
  return locales.map((locale) => {
    return {
      params: {
        locale: locale,
      },
    };
  });
}

const locale = Astro.params.locale;
const effectiveLocale = locale;

const i18nInstance = initI18n(effectiveLocale);
const t = i18nInstance.t.bind(i18nInstance);
const htmlLang = locale === "zh" ? "zh-Hans" : locale;
const pageTitle = t("info.faqPage.title");
const pageDescription = t("info.faqPage.subtitle");
const canonicalPath = "/faq";

const siteUrl = "https://excel2vcf.com";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${siteUrl}/${locale}${canonicalPath}/`,
      "url": `${siteUrl}/${locale}${canonicalPath}/`,
      "name": pageTitle,
      "description": pageDescription,
      "inLanguage": locale
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": t("info.faqPage.q1"),
          "acceptedAnswer": {
            "@type": "Answer",
            "text": t("info.faqPage.a1")
          }
        },
        {
          "@type": "Question",
          "name": t("info.faqPage.q2"),
          "acceptedAnswer": {
            "@type": "Answer",
            "text": t("info.faqPage.a2")
          }
        },
        {
          "@type": "Question",
          "name": t("info.faqPage.q3"),
          "acceptedAnswer": {
            "@type": "Answer",
            "text": t("info.faqPage.a3")
          }
        },
        {
          "@type": "Question",
          "name": t("info.faqPage.q4"),
          "acceptedAnswer": {
            "@type": "Answer",
            "text": t("info.faqPage.a4")
          }
        }
      ]
    }
  ]
};

// Native <details> accordion: answers stay in the server-rendered HTML (crawlable)
// and no longer depend on Alpine.js or its x-collapse plugin.
const faqNumbers = [1, 2, 3, 4];
---

<BaseLayout
  htmlLang={htmlLang}
  lang={locale}
  t={t}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  canonicalPath={canonicalPath}
>
  <JsonLd schema={schema} />
  <section class="px-6 md:px-12 lg:px-24 pt-16 md:pt-20 pb-20 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-12">
      <div class="text-center lg:text-left">
        <h1
          class="text-2xl leading-tight tracking-tight sm:text-3xl md:text-4xl font-medium text-base-900 lg:text-balance"
        >
          {pageTitle}
        </h1>
        <p class="text-base leading-normal mt-4 text-base-500 font-medium">
          {pageDescription}
        </p>
      </div>
      <div class="relative w-full mx-auto font-normal lg:col-span-2 divide-y divide-base-200">
        {faqNumbers.map((n, index) => (
          <details class="group py-1" open={index === 0}>
            <summary
              class="flex items-center justify-between w-full gap-4 p-4 cursor-pointer list-none font-medium text-base-900 hover:text-accent-600 transition-colors"
            >
              <span>{t(`info.faqPage.q${n}`)}</span>
              <svg
                class="size-5 shrink-0 duration-300 ease-out text-accent-500 transition-transform group-open:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="px-4 pt-1 pb-4 text-base-600" set:html={t(`info.faqPage.a${n}`)}></div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
